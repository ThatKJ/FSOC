build/
cmake-build-*/
out/
generated/
.DS_Store
.vscode/*.log
compile_commands.json
*.dSYM/
*.profraw
*.gcda
*.gcno

# --- V2 AI PERCEPTION ---
# Datasets/eval artifacts are regenerated from a fixed seed, never committed
# (generated/ is already ignored; listed explicitly for clarity).
generated/ai_dataset/
generated/ai_validation/
# Offline Python training tooling — not part of the C++ runtime.
tools/ai/.venv/
.venv/
.venv-ai/
__pycache__/
*.pyc
# Training artifacts: the exported ONNX model IS committed (models/*.onnx);
# bulky checkpoints / TensorBoard logs are not.
models/*.pt
models/*.pth
models/*.ckpt
models/checkpoints/
models/runs/

# --- Mobile Phone Camera-in-the-Loop ---
# Personal, hardware-specific camera calibration (your phone's FOV, not a
# general default) — see docs/PHONE_CAMERA_METRICS.md "Camera calibration".
configs/

# --- FSOC launcher ---
# Local, non-secret overrides (see fsoc.env.example, which IS committed).
fsoc.env

# --- Local AI-agent session artifacts ---
# Claude Code terminal transcript exports land at repo root as
# YYYY-MM-DD-HHMMSS-<slug>.txt (e.g. 2026-09-08-103830-...); local-only,
# never intended to be committed.
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt
